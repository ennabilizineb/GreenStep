# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Application ---
APP_ENV=development
DISPLAY_ERROR_DETAILS=true

# --- Database (MySQL via PDO) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=greenstep
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- JWT (Firebase php-jwt) ---
# Generate a long random secret, e.g.:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=greenstep-api
JWT_TTL=3600
